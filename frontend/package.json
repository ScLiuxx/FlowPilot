{
  "name": "flowpilot-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FlowPilot 管理控制台 - Vue 3 + TypeScript SPA",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
