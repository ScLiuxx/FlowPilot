{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flowpilot.io/protocol/node/node-execute.schema.json",
  "title": "NodeExecutePayload",
  "type": "object",
  "required": ["nodeKey", "nodeType"],
  "properties": {
    "nodeKey": { "type": "string" },
    "nodeType": { "type": "string", "enum": ["HTTP", "CODE", "CONDITION", "LLM", "AGENT", "HUMAN", "MERGE"] },
    "config": { "type": "object" },
    "input": { "type": "object" },
    "timeoutSeconds": { "type": "integer" }
  }
}
