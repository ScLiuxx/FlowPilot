{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flowpilot.io/protocol/agent/agent-interrupted.schema.json",
  "title": "AgentInterruptedPayload",
  "type": "object",
  "required": ["invocationId", "threadId", "interruptType"],
  "properties": {
    "invocationId": { "type": "integer", "format": "int64" },
    "threadId": { "type": "string" },
    "checkpointId": { "type": ["string", "null"] },
    "interruptType": { "type": "string", "enum": ["HUMAN_APPROVAL"] },
    "interruptData": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "requestedAction": { "type": "string" },
        "payload": { "type": "object" }
      }
    }
  }
}
